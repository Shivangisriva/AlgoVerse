    class Solution {
    class Pair
    {
        int row;
        int col;
        int step;
        Pair(int row , int col , int step)
        {
            this.row = row;
            this.col = col;
            this.step = step;
        }
    }
  public int[][] updateMatrix(int[][] grid) {        // code here
        int m = grid.length;
        int n = grid[0].length;
        int visited[][] = new int[m][n];
       int dist[][]= new int[m][n];
         
         Queue<Pair> q =new LinkedList<>();
         
         for(int i = 0 ; i < m ; i++)
         {
             for(int j = 0 ; j< n ; j++)
             {
                 if(grid[i][j] == 0)
                 {
                     visited[i][j] = 1;
                     q.offer(new Pair(i , j , 0));
                 }
                 else
                 visited[i][j] =0;
             }
         }
         
           int drow[] = {-1  , 0 , +1 , 0};
        int dcol[] = {0 , -1 , 0 , +1};
         while(!q.isEmpty())
         {
             Pair val = q.poll();
             int r = val.row;
             int c = val.col;
             int s = val.step;
             
             dist[r][c] = s;
             
              for(int i = 0 ; i<4; i++)
         {
            int newR = r + drow[i];
            int newC = c + dcol[i];
            if(newR>=0 && newC>=0 && newR<m && newC < n && visited[newR][newC] ==0)
            {
                visited[newR][newC] = 1;
                q.offer(new Pair(newR , newC , s+1));
            }
         }
    }
     return dist;
    }
}
