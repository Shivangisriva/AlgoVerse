class Solution {
    class Pair
    {
        int node;
        int parent;
        Pair(int node , int parent)
        {
            this.node = node;
            this.parent = parent;
        }
    }
    public boolean isCycle(int V, int[][] edges) {
        // Code here
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
        for(int i = 0; i< V; i++)
        {
            adj.add(new ArrayList<>());
        }
        
        for(int i = 0 ; i< edges.length ; i++)
        {
            int u = edges[i][0];
            int v = edges[i][1];
            
            adj.get(u).add(v);
            adj.get(v).add(u);
            }
            
            int visited[] =new int[V];
          for (int i = 0; i < V; i++) {
            if (visited[i] == 0) {
                if (bfs(visited, adj, i)) return true;
            }
        }

        return false;
    }
     boolean bfs(int visited[]  , ArrayList<ArrayList<Integer>> adj , int node)
    {
          Queue<Pair> q =new LinkedList<>();
            q.offer(new Pair(node , -1));
            visited[node] =1;
            
            while(!q.isEmpty())
            {
                Pair val = q.poll();
                int n = val.node;
                int p = val.parent;
                
                for(Integer it : adj.get(n))
                {
                    if(visited[it] == 0)
                    {
                        q.offer(new Pair(it , n));
                        visited[it] = 1;
                    }
    // "My neighbour is already visited, and it is NOT the node I came from → cycle."
                    else if(p != it && visited[it] == 1)
                    return true;
                }
            }
            return false;
            
    }
}
