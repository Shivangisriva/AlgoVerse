class Solution {
  void  dfs(int r , int c , int vis[][] , char board[][])
    {
         int m = board.length;
        int n = board[0].length;
        vis[r][c] = 1;

        
           int drow[] = {-1  , 0 , +1 , 0};
        int dcol[] = {0 , -1 , 0 , +1};
        for(int i = 0; i<4;i++)
        {
             int newR = r + drow[i];
            int newC = c + dcol[i];
            if(newR>=0 && newC>=0 && newR<m && newC < n && vis[newR][newC] ==0 && board[newR][newC] == 'O')
            {
                dfs(newR , newC , vis , board);
        }
    }
    }
    public void solve(char[][] board) {
        int m = board.length;
        int n = board[0].length;

        int vis[][] = new int[m][n];
        
        //traversing in the first row n col
       for (int j = 0; j < n; j++) {
            if (board[0][j] == 'O')
                dfs(0, j, vis, board);

            if (board[m - 1][j] == 'O')
                dfs(m - 1, j, vis, board);
        }

        // 2. Left col & right col
        for (int i = 0; i < m; i++) {
            if (board[i][0] == 'O')
                dfs(i, 0, vis, board);

            if (board[i][n - 1] == 'O')
                dfs(i, n - 1, vis, board);
        }


        for(int i = 0; i < m ; i++)
        {
            for(int j = 0 ; j< n ; j++)
            {
                if(vis[i][j] == 0 && board[i][j] == 'O')
                {
                    board[i][j] = 'X';
                }
            }
        }

    }
}
