class Solution {
    // multi-source BFS
    class Pair
    {
        int row;
        int col;
        int time;
        Pair(int row , int col , int time)
        {
            this.row = row;
            this.col = col;
            this.time = time;
        }
    }
    public int orangesRotting(int[][] grid) {
        Queue<Pair> q = new LinkedList<>();
        int n = grid.length;
        int m = grid[0].length;
        int freshCnt = 0;
        int visited[][] = new int[n][m];
        for(int i = 0 ; i<n ; i++)
        {
            for(int j = 0; j<m ; j++)
            {
                if(grid[i][j] == 2)
                {
                    q.offer(new Pair(i , j , 0));
                    visited[i][j] = 2;
                }
                else
                visited[i][j] = 0;
                if(grid[i][j] == 1)
                freshCnt++;
            }
        }
        int drow[] = {-1 , 0 , 1 , 0};
        int dcol[]= {0 , -1 , 0 , 1};
        int tmax = 0;
        int cnt = 0;
        while(!q.isEmpty())
        {
     
      int size = q.size();
           
      
    for(int i =0 ; i<size ; i++ )
    {
         Pair curr = q.poll();
          int r = curr.row;
      int c = curr.col;
      int time = curr.time;
      tmax = Math.max(tmax , time);
      for( int k  = 0 ; k<4 ; k++)
      {
        int nrow = r + drow[k];
        int ncol = c + dcol[k];
        if(nrow>=0 && ncol>=0 && nrow<n && ncol<m && visited[nrow][ncol] == 0 && grid[nrow][ncol] == 1)
        {
            q.offer(new Pair(nrow , ncol, time+1));
              cnt++;
              visited[nrow][ncol] = 2;
        }
    }
    }
        }
         if(cnt!=freshCnt)
    return -1;
    return tmax;
    }
}
