class Solution {
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {
        // code here
        ArrayList<Integer> ans = new ArrayList<>();
        int n = adj.size();
        int visited[] = new int[n];
        Queue<Integer> q = new LinkedList<>();
        
        q.offer(0);
        visited[0] = 1;
        
        while(!q.isEmpty())
        {
            int val = q.poll();
            ans.add(val);
            
            for(Integer it : adj.get(val))
            {
                 if (visited[it] == 0) {
                visited[it] = 1;
                q.offer(it);
            }
        }
        }
        return ans;
        
    }
}
