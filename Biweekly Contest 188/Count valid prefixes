class Solution {
    public int countValidPrefixes(String s) {
        int cnt0 = 0 , cnt1 = 0;
        int prefix = 0;
        for(int i = 0; i< s.length() ; i++)
            {
                char ch = s.charAt(i);
                if(ch == '1') cnt1++;
                else cnt0++;
                if(Math.abs(cnt1 - cnt0) <= 1)
                    prefix++;
            }
       return prefix;
    }
}©leetcode
