class Solution {
    public int countRatioSubarrays(int[] nums, int a, int b) {
        int n = nums.length;
        int comp = a/b;
        int ans = 0;
        for(int i = 0; i<n ; i++)
            {
                int cntE = 0 , cntO = 0;
              for(int j = i;j<n ; j++)
                  {
                   if(nums[j]%2 == 0)
                       cntE++;
                      else
                       cntO++;
                      if(cntO>0 && (1L*cntE*b <= 1L*cntO*a))
                    ans++;
                  }
            }
        return ans;
    }
}©leetcode
