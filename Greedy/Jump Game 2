class Solution {
    public int jump(int[] nums) {
        int currEnd = 0;
        int farthest =0;
        int jump=0;
        int n = nums.length;
        for(int i = 0; i<n-1;i++)
        // We need jumps needed to reach the last index and not to process the last index
        {
        farthest = Math.max(farthest , i+nums[i]);

        if(i== currEnd)
        {
        jump++;
        currEnd  = farthest;
        }
        }
        return jump;
        }
    }
