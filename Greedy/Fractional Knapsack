class Solution {
    static class ItemComparator implements Comparator<int[]>{
        public int compare(int a[] , int b[])
        {
            double an = (1.0*a[0])/a[1];
            double bn = (1.0*b[0])/b[1];
            return Double.compare(bn,an);
    }
    }
    double fractionalKnapsack(int[] values, int[] weights, int W) {
        // code here
        int n = values.length;
        int items[][] = new int[n][2];
        for(int i = 0 ;  i< n;i++)
        {
            items[i][0] = values[i];
            items[i][1] = weights[i];
        }
        Arrays.sort(items, new ItemComparator());
        double res = 0.0;
        int currcap = W;
        for(int i = 0; i< n; i++)
        {
            if(items[i][1]<= currcap)
            {
                res+= items[i][0];
                currcap -= items[i][1];
            }
            else
            {
                res+=((1.0* items[i][0])/items[i][1])*currcap;
                break;
        }
    }
    return res;
}
}
