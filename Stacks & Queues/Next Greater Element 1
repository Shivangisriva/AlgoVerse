class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {

/*
Instead of searching for every element separately (O(n²)):

Find the next greater element for every number in nums2.
Store it in a HashMap.
Lookup answers for nums1 in O(1).
*/

        Stack<Integer> stack = new Stack<>();
        HashMap<Integer , Integer> map = new HashMap<>();
        int ans[] = new int[nums1.length];
        for(int i = nums2.length-1 ; i>= 0  ; i--)
        {
        while(!stack.isEmpty() && stack.peek()<= nums2[i])
        {
        stack.pop();
        }

        int nxtgrt = (stack.isEmpty()?-1:stack.peek());
        map.put(nums2[i] , nxtgrt);

        stack.push(nums2[i]);
        }
    
    for(int j = 0; j< nums1.length;j++)
    {
   ans[j] = map.get(nums1[j]);
    }
return ans;
}
}
