class MyStack {
Queue<Integer> q;
int rear;
    public MyStack() {
        q = new LinkedList<>();
       
        rear = 0;
    }   
    public void push(int x) {
        q.add(x);
        rear = x;
    }    
    public int pop() {
        if(empty()) return -1;
       int size = q.size();
    for (int i = 0; i < size - 1; i++) {
        int front = q.remove();  
        q.add(front);            
    }
    return q.remove();
    }  
    public int top() {
    if(empty()) return -1;

    int size = q.size();

    for(int i = 0; i < size - 1; i++) {
        q.add(q.remove());
    }

    int topElement = q.peek(); // last inserted element is now at front

    q.add(q.remove()); // restore original order

    return topElement;
}    
    public boolean empty() {
       if(q.isEmpty())
       return true;
       return false;
    }
}

