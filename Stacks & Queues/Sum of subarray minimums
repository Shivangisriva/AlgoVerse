class Solution {
    public int sumSubarrayMins(int[] arr) {
        int nse[]  = new int[arr.length];
        int psee[] = new int[arr.length];;
      nse = nse(arr);
      psee = psee(arr);
      int n = arr.length;
      int mod =(int)1e9+7;
     long tot = 0;

for (int i = 0; i < n; i++) {
    long left = i - psee[i];
    long right = nse[i] - i;
    long contrib = (arr[i] * left) % mod;
    contrib = (contrib * right) % mod;
    tot = (tot + contrib) % mod;
}
return (int) tot;
    }
    static int[] nse(int arr[])
    {
        Stack<Integer> st = new Stack<>();
        int nse[]  = new int[arr.length];
        int n = arr.length;
        for(int i = n-1;i>=0;i--)
        {
while(!st.isEmpty() && arr[st.peek()]>= arr[i])
st.pop();

nse[i] = st.isEmpty()?n:st.peek();

st.push(i);
        }
        return nse; 
    }

    static int[]  psee(int arr[])
    {
          Stack<Integer> st = new Stack<>();
        int psee[]  = new int[arr.length];
        int n = arr.length;
        for(int i = 0;i<n;i++)
        {
while(!st.isEmpty() && arr[st.peek()]> arr[i])
st.pop();

psee[i] = st.isEmpty()?-1:st.peek();

st.push(i);
        }
        return psee; 
    } 
    }
