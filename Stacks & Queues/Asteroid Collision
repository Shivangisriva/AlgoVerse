class Solution {
    public int[] asteroidCollision(int[] asteroids) {
        Stack<Integer> st = new Stack<>();
        for(int a : asteroids)
        {
            boolean d = false;
            while(!st.isEmpty() && a<0 && st.peek()>0)
            {
                if(Math.abs(a) > st.peek())
                st.pop();
              else  if(Math.abs(a) == st.peek()){
                st.pop();
                d = true;
                break;
              }
              else
              {
                    d = true;
                break;
              }
            }
            
            if(!d)
            st.push(a);
        }
      int n = st.size();
int[] arr = new int[n];
for (int i = n - 1; i >= 0; i--) {
    arr[i] = st.pop();
}
return arr;

    }
}
