class Pair<U, V> {
    public U first;
    public V second;

    public Pair(U first, V second) {
        this.first = first;
        this.second = second;
    }
}
class StockSpanner {
Stack<Pair<Integer , Integer>> st;
int ind;
    public StockSpanner() {
        ind = -1;
        st = new Stack<>();
    }
    
    public int next(int price) {
        ind +=1;
        while(!st.isEmpty() && st.peek().first <= price)
        st.pop();

        int ans = ind-(st.isEmpty()?-1:st.peek().second);
        st.push(new Pair<>(price,ind));
return ans;
    }
    
}

