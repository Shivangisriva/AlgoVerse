class Solution {
    public int zigzagSequence(int[][] mat) {
        // code here
        int n = mat.length;
 int dp[][] = new int[n][n];

for(int i = 0 ; i< n ; i++)
{
    dp[0][i]  = mat[0][i];
}
int sum = 0;
for(int i = 1; i < n  ; i++)
{
    for(int j = 0 ; j< n; j++)
    {
        int best= 0;
        for(int k = 0; k< n; k++)
        {
            if(k!=j)
            best = Math.max(best , dp[i-1][k]);
        }
     dp[i][j] = mat[i][j]+best;   
    }
}

int ans = 0;
for(int i = 0 ; i< n; i++)
{
    ans = Math.max(ans , dp[n-1][i]);
}
return ans;
    }
}
