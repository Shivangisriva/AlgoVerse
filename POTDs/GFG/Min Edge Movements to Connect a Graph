class Solution {
    int minEdgesReq(int n, int[][] edges) {
        // code here
        int size = edges.length;
        if(size < n-1) return -1;
        // ans will be = (no. of connected components - 1)
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
        for(int i = 0; i<n;i++)
        {
            adj.add(new ArrayList<>());
        }
        for(int e[] : edges)
        {
            int u = e[0];
            int v = e[1];
            adj.get(u).add(v);
            adj.get(v).add(u);
        }
        int compo = 0;
        int vis[] = new int[n];
        for(int i = 0 ; i< n ; i++){
            if(vis[i] == 0 )
            {
                dfs(i , adj , vis);
                compo++;
            }
        }
        return compo-1;
        }
        void dfs(int node , ArrayList<ArrayList<Integer>> adj , int vis[])
        {
            vis[node] = 1;
            for(Integer it : adj.get(node))
            {
                if(vis[it] == 0)
                dfs(it , adj , vis);
            }
        }
}
