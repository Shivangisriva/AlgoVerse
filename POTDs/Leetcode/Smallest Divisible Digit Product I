class Solution {
    public int smallestNumber(int n, int t) {
        int nn = n;
        while(true)
        {
            int pro = 1;
            for(int i = n ; i>0; i=i/10)
            {
                int d = i%10;
                pro =pro*d;
            }
            if(pro%t == 0)
            return n;
            else
            n++;
        }
    }
}
