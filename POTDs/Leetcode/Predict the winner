class Solution {
    public boolean predictTheWinner(int[] nums) {
        int n = nums.length;
        int total = 0;
        for (int val : nums) total += val;

        int score1 = helper(0, n - 1, 0, nums);
        int score2 = total - score1;

        return score1 >= score2;
    }

    private int helper(int i, int j, int turn, int[] nums) {
        if (i > j) return 0;

        if (turn == 0) { 
            int pickLeft = nums[i] + helper(i + 1, j, 1, nums);
            int pickRight = nums[j] + helper(i, j - 1, 1, nums);
            return Math.max(pickLeft, pickRight);
        } else {
            int pickLeft = helper(i + 1, j, 0, nums);
            int pickRight = helper(i, j - 1, 0, nums);
            return Math.min(pickLeft, pickRight);
        }
    }
}
