class Solution {

    int[][][] dp;

    public boolean stoneGame(int[] piles) {

        int n = piles.length;

        int total = 0;

        for(int x:piles)
            total += x;


        dp = new int[n][n][2];

        for(int i=0;i<n;i++)
        {
            for(int j=0;j<n;j++)
            {
                Arrays.fill(dp[i][j], -1);
            }
        }

        int alice = helper(0,n-1,0,piles);
        int bob = total - alice;
        return alice > bob;
    }
    int helper(int i,int j,int turn,int[] piles)
    {
        if(i>j)
            return 0;
        if(dp[i][j][turn] != -1)
            return dp[i][j][turn];
        if(turn==0)
        {
            int takeLeft =
                piles[i] + helper(i+1,j,1,piles);

            int takeRight =
                piles[j] + helper(i,j-1,1,piles);

            return dp[i][j][turn] =
                Math.max(takeLeft,takeRight);
        }
        else
        {
            int takeLeft =
                helper(i+1,j,0,piles);

            int takeRight =
                helper(i,j-1,0,piles);
            return dp[i][j][turn] =
                Math.min(takeLeft,takeRight);
        }
    }
}
