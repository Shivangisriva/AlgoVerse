class Solution {
    public int[] validSequence(String word1, String word2) {

        int n = word1.length();
        int m = word2.length();

        int[] suf = new int[n + 1];

        int j = m - 1;

        for (int i = n - 1; i >= 0; i--) {
            if (j >= 0 && word1.charAt(i) == word2.charAt(j)) {
                j--;
            }
            suf[i] = j + 1;
        }

        List<Integer> ans = new ArrayList<>();

        boolean usedMismatch = false;
        j = 0;

        for (int i = 0; i < n && j < m; i++) {

            char c1 = word1.charAt(i);
            char c2 = word2.charAt(j);

            // Exact match
            if (c1 == c2) {
                ans.add(i);
                j++;
            }

            // Use the one allowed mismatch
            else if (!usedMismatch && suf[i + 1] <= j + 1) {
                //"After taking this mismatching character, is the remaining part of word1 enough to finish word2?
                ans.add(i);
                usedMismatch = true;
                j++;
            }
        }

        if (ans.size() != m) {
            return new int[0];
        }

        int[] res = new int[m];

        for (int i = 0; i < m; i++) {
            res[i] = ans.get(i);
        }

        return res;
    }
}
