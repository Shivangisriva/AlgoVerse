class Solution {

    public int[] getFloorAndCeil(int[] arr, int x) {

        int low = 0;
        int high = arr.length - 1;

        int floor = -1;
        int ceil = -1;


        while (low <= high) {

            int mid = low + (high - low) / 2;


            if (arr[mid] == x) {

                // exact match is both floor and ceil
                floor = arr[mid];
                ceil = arr[mid];
                break;

            } 
            else if (arr[mid] < x) {

                // possible floor, search right for a bigger value
                floor = arr[mid];
                low = mid + 1;

            } 
            else {

                // possible ceil, search left for a smaller value
                ceil = arr[mid];
                high = mid - 1;

            }
        }


        return new int[]{floor, ceil};
    }
}
