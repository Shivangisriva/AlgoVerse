class Solution {
    public static double findSmallestMaxDist(int[] stations, int k) {
        double low = 0, high = stations[stations.length - 1] - stations[0];
        double diff = 1e-6; // Precision for binary search

        while (high - low > diff) {
            double mid = low + (high - low) / 2.0;
            int count = countNumberOfStations(stations, mid);

            if (count > k) {
                low = mid; // Increase the allowed distance
            } else {
                high = mid; // Decrease the allowed distance
            }
        }

        return high;
    }

    private static int countNumberOfStations(int[] stations, double dist) {
        int count = 0;

        for (int i = 1; i < stations.length; i++) {
            double gap = stations[i] - stations[i - 1];
            count += (int) (gap / dist);
        }

        return count;
    }
}
