class Solution {
    public int singleNonDuplicate(int[] nums) {
        //Before the single element, the first occurrence of each pair at even index
//After the single element, the first occurrence of each pair is at odd index.
//Use binary search to find where this pattern breaks.

int low = 0 , high = nums.length-1;
while(low<high)
{
    int mid   = low+(high - low)/2;
    if(mid%2 == 1)
    mid--;
    if(nums[mid] == nums[mid+1])
    low = mid+2;
    else
    high = mid;
}
return nums[low];
    }
}
