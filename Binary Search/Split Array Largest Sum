class Solution {
    public int splitArray(int[] nums, int k) {
       int low = Arrays.stream(nums).max().getAsInt();
        int high = Arrays.stream(nums).sum();
        int ans= high;
      while(low<=high)
      {
        int mid = low +(high - low)/2;
        int cal = func(nums , mid);
        if(cal <= k)
        {
        ans = mid ;
        high = mid-1;
        }
        else
        low = mid+1;
      }
      return ans;
    }
   int func(int nums[] , int pages)
    {
        int stu = 1 , pg =0;
        for(int i = 0 ;i< nums.length ; i++)
        {
            if(nums[i]+pg > pages)
            {
                stu++;
                pg = nums[i];
            }
            else
             pg+=nums[i];
        }
        return stu;
    }
}
