class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {
        int count = 0;
        ListNode temp = head;
        while(temp!=null)
        {
            count++;
            temp = temp.next;
        }
        ListNode dummy = new ListNode(-1);
        dummy.next = head;
       ListNode prev = dummy;
        ListNode curr;
        ListNode next;
        while(count >= k)
        {
            
         curr = prev.next;
         next = curr.next;
            
        for(int i = 1 ; i < k ; i++)
        {
        curr.next = next.next;
        next.next = prev.next;
        prev.next = next;
        next = curr.next;
        }
        prev = curr;
        count -=k;
        }
        return dummy.next;
    }
}
