class Solution {

    static Node reverse(Node head) {
        Node prev = null;
        Node curr = head;

        while (curr != null) {
            Node next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }

        return prev;
    }

    public Node addOne(Node head) {

        head = reverse(head);

        Node temp = head;
        int carry = 1;

        while (temp != null) {

            int sum = temp.data + carry;
            temp.data = sum % 10;
            carry = sum / 10;

            if (temp.next == null && carry > 0) {
                temp.next = new Node(carry);
                carry = 0;
            }

            temp = temp.next;
        }

        return reverse(head);
    }
}
