class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        if (n < 1 || head == null)
            return head;

        ListNode temp = head;
        int size = 0;

        while (temp != null) {
            size++;
            temp = temp.next;
        }

        int find = size - n;

        if (find == 0)
            return head.next;

        temp = head;
        ListNode prev = null;

        for (int i = 0; i < find; i++) {
            prev = temp;
            temp = temp.next;
        }

        if (prev != null && temp != null)
            prev.next = temp.next;

        return head;
    }
}
