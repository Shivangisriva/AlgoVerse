class Solution {
    void reverse(int nums[] , int start , int end)
    {
        while(start< end)
        {
            int temp = nums[start];
            nums[start] = nums[end];
            nums[end] = temp;
            start++;
            end--;
        }
    }
    void swap(int a , int b , int nums[])
    {
        int temp = nums[a];
        nums[a] = nums[b];
        nums[b] = temp;
    }
    public void nextPermutation(int[] nums) {
        int bp = -1 , index = -1;
        int n = nums.length;
        for(int i = n-2 ; i>=0 ; i--)
        {
            if(nums[i] <  nums[i+1])
            {
                bp = i;
                break;
            }
        }
         if(bp == -1)
        //reverse
        {
        reverse(nums , 0 , nums.length -1);
        return ;
        }

        for(int j = n-1  ; j>=bp+1 ; j--)
        {
          if(nums[j] > nums[bp])
          {
            index = j;
            break;
          }
        }
      swap(index , bp , nums);
        reverse(nums , bp+1 , nums.length -1);
    }
}
