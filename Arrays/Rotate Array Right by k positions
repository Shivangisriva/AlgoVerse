class Solution {
    void rev(int nums[] , int s , int e)
    {
        while(s<e)
        {
            int temp = nums[s];
            nums[s] = nums[e];
            nums[e] = temp;
            s++;
            e--;
        }
    }
    public void rotateRight(int[] nums, int k) {
        int n = nums.length;
        if(k>n)
        k = k%n;

        rev(nums , 0 , n-1);//left step 3
        rev(nums , 0 , k-1);// left step 1
        rev(nums , k , n-1);// left step 2
    }
}
