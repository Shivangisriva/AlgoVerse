class Solution {
    public int longestConsecutive(int[] nums) {
        HashSet<Integer> set = new HashSet<>();
        for(int val : nums)
        set.add(val);
         
         int max = Integer.MIN_VALUE;
        for(int val : set)
        {
            if(!set.contains(val-1))
            {
                int curr = val;
                int streak = 1;
                while(set.contains(curr+1))
                {
                    curr++;
                    streak++;
                }
                max = Math.max(max , streak);
            }
        }
        return max== Integer.MIN_VALUE?0:max;
    }
}
