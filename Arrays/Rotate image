class Solution {
    void transpose(int mat[][])
    {
    int n = mat.length;
  
    for(int i = 0 ; i < n; i++)
    {
        for(int j = i+1 ; j< n; j++)
        {
            int temp = mat[i][j];
            mat[i][j] =  mat[j][i];
            mat[j][i] =  temp;
        }
    }
}
    public void rotate(int[][] matrix) {
        int n = matrix.length;
        transpose(matrix);
        int left = 0 , right =  n-1;
        while(left < right)
        {
            for(int i = 0 ; i< n; i++)
            {
                int temp = matrix[i][left];
                matrix[i][left] = matrix[i][right];
                matrix[i][right] = temp;
            }
            left++;
            right--;
        }
    }
}
