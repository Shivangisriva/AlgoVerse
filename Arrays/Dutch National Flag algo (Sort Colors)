class Solution {
    public void sortColors(int[] nums) {
        //Dutch National Flag Algorithm
        int low = 0, mid = 0 , high = nums.length-1;
        while(mid<=high)
        {
            if(nums[mid] == 0)
            {
            swap(mid,low,nums);
            low++;
            mid++;
            }
            else if(nums[mid]== 1)
            {
            mid++;
            }
            else if(nums[mid]== 2)
            {

                swap(mid, high ,nums);
                high--;
            }

        }
    }
    static void swap(int a , int b , int arr[])
    {
        int temp = arr[a];
        arr[a] = arr[b];
        arr[b] = temp;
    }

    }
