class Solution {
    public int maxProduct(int[] nums) {
      int n = nums.length;
        int prev = 1, suff = 1;
        int max = Integer.MIN_VALUE;
       for(int i=0;i<n;i++)
       {
           if(prev == 0)
           prev= 1;
           if(suff ==0)
           suff =1;
           prev = prev * nums[i];
           suff = suff * nums[n-i-1];
           max = Math.max(max,Math.max(prev, suff));
       }
       return max;
    }  
    }
