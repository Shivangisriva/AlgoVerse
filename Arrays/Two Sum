class Solution {
    public int[] twoSum(int[] nums, int target) {
        HashMap<Integer, Integer> map = new HashMap<>();
       
     for(int i = 0 ; i< nums.length ; i++)
     {
        int val = nums[i];
        int toFind = target-val;
        if(map.containsKey(toFind))
        return new int[]{i , map.get(toFind)};
        else
        map.put(nums[i] , i);
     }
     return new int[]{-1 , -1};
    }
}
