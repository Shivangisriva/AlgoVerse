# Write your MySQL query statement below
Select pro.product_name , p.unit
from
(Select product_id , order_date , sum(unit) as unit
from Orders
where order_date >='2020-02-01'
and order_date<'2020-03-01'
group by product_id ) as p
join
Products as pro
on pro.product_id = p.product_id
having unit>=100

