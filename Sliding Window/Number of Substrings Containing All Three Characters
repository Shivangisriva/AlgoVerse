class Solution {
    public int numberOfSubstrings(String s) {
        int left = 0, right = 0 ,occ=0 , countA = 0, countB=0, countC =0;
       int freq[] = new int [3];
        for(right = 0; right < s.length();right++)
        {
           char ch = s.charAt(right);
           if(ch == 'a') countA++;
           if(ch == 'b') countB++;
           if(ch == 'c') countC++;

           while(countA >0 && countB>0 && countC >0)
           {
            ch = s.charAt(left);
            if(ch == 'a') countA--;
            if(ch == 'b') countB--;
           if(ch == 'c') countC--;
           left++;
           }
           occ +=left;
           }
        return occ;
    }
}
