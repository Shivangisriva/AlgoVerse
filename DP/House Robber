---------------------------------------------MEMOIZATION-------------------------------------------------------------
class Solution {
    int dp[];
    public int rob(int[] nums) {
        if(nums.length == 1)
        return nums[0];
        dp = new int[nums.length];
        Arrays.fill(dp,-1);
        return helper(0,nums);
    }
    int helper(int ind , int nums[])
    {
        if(ind >= nums.length)
        {
  return 0;
        }
        if(dp[ind]!=-1)
        return dp[ind];
      int pick = nums[ind] + helper(ind+2,nums);
      int npick = helper(ind+1,nums);
      return dp[ind] = Math.max(pick,npick);

    }
}
---------------------------------------------TABULATION-------------------------------------------------------------
class Solution {
    int dp[];
    public int rob(int[] nums) {
        if(nums.length == 1)
        return nums[0];
        dp = new int[nums.length];
     dp[0] = nums[0];
     dp[1] = Math.max(nums[0],nums[1]);
  
       for(int i = 2;i<nums.length;i++)
       {
      int pick = nums[i] + dp[i-2];
      int npick = dp[i-1];
       dp[i] = Math.max(pick,npick);
    }
    return dp[nums.length-1];
}
}
