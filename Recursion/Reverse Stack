https://www.geeksforgeeks.org/problems/reverse-a-stack/1

class Solution {
    public void reverseStack(Stack<Integer> st) {
        if (st.isEmpty()) return;           // base case
        int top = st.pop();
        reverseStack(st);                   // reverse the remaining stack
        insertBottom(st, top);              // insert popped element at the bottom
    }

    void insertBottom(Stack<Integer> st , int x) {
        if (st.isEmpty()) {
            st.push(x);
            return;
        }

        int top = st.pop();
        insertBottom(st, x);                // recurse to insert x at bottom
        st.push(top);                       // push back the top element
    }
}
