class Solution {
    List<String> res = new ArrayList<>();
    public List<String> addOperators(String num, int target) {
        helper(num , 0 , "" , 0 , 0 ,target);
        return res;
    }
    void helper(String num , int ind , String sval , long val , long prev , int target)
    {
        if(ind == num.length())
        {
            if(val == target)
            res.add(sval);
            return; 
        }
        for(int i = ind;i<num.length() ; i++)
        {
            if(i>ind && num.charAt(ind)=='0')
            break;//"0" → valid
//                 "05" → invalid
//                If curr number starts with 0 and has more than 1 digit
            String currs = num.substring(ind,i+1);
            long currn = Long.valueOf(currs);
            if(ind == 0)// thissssss
            {
                helper(num , i+1 , currs , currn, currn , target );//thissss (i+1)
            }
            else
            {
                  helper(num , i+1 , sval+'+'+currs , val+currn, currn , target );
                helper(num , i+1 ,sval+'-'+ currs , val-currn,-currn , target );
                helper(num , i+1 ,sval+'*'+ currs , val-prev+(prev*currn), prev*currn , target );              
            }
        }
    }
}
