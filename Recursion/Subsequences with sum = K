class Solution {
    void find(int ind, int[] nums, int target, List<Integer> ds, List<List<Integer>> ans, int sum) {
        // Base case
        if (ind == nums.length) {
            if (sum == target) {
                ans.add(new ArrayList<>(ds));
            }
            return;
        }

        // Include nums[ind]
        ds.add(nums[ind]);
        find(ind + 1, nums, target, ds, ans, sum + nums[ind]);

        // Backtrack
        ds.remove(ds.size() - 1);

        // Exclude nums[ind]
        find(ind + 1, nums, target, ds, ans, sum);
    }

    public List<List<Integer>> subsequencesWithSumK(int[] nums, int k) {
        List<List<Integer>> ans = new ArrayList<>();
        find(0, nums, k, new ArrayList<>(), ans, 0);
        return ans;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();
        int[] nums = {1, 2, 1};
        int k = 2;
        List<List<Integer>> ans = sol.subsequencesWithSumK(nums, k);
        System.out.println(ans);
    }
}
