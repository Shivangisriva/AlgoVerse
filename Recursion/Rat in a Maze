import java.util.*;

class Solution {
    public ArrayList<String> ratInMaze(int[][] maze) {
        ArrayList<String> list = new ArrayList<>();
        int n = maze.length;
        if (n == 0 || maze[0][0] == 0 || maze[n - 1][n - 1] == 0) 
            return list; // no path

        helper(maze, 0, 0, list, "");
        Collections.sort(list); // lexicographically smallest
        return list;
    }

    static void helper(int[][] maze, int i, int j, ArrayList<String> list, String path) {
        // out of bounds
        if (i < 0 || j < 0 || i >= maze.length || j >= maze[0].length) return;
        
        // blocked or visited
        if (maze[i][j] == 0 || maze[i][j] == -1) return;

        // reached destination
        if (i == maze.length - 1 && j == maze[0].length - 1) {
            list.add(path);
            return;
        }

        // mark visited
        maze[i][j] = -1;

        // explore all 4 directions (Down, Left, Right, Up for lexicographic order)
        helper(maze, i + 1, j, list, path + "D");
        helper(maze, i, j - 1, list, path + "L");
        helper(maze, i, j + 1, list, path + "R");
        helper(maze, i - 1, j, list, path + "U");

        // unmark for backtracking
        maze[i][j] = 1;
    }
}
