class Solution {
   void find(int ind ,ArrayList<Integer> ds, List<List<Integer>> ans , int arr[])
    {
            ans.add(new ArrayList<>(ds));
            
        for(int i = ind;i<arr.length ; i++)
        {
            if(i > ind && arr[i]==arr[i-1])
            continue;
            ds.add(arr[i]);
            find(i+1, ds , ans , arr);
            ds.remove(ds.size()-1);
        }
    }
    public List<List<Integer>> subsetsWithDup(int[] nums) {
        Arrays.sort(nums);
         List<List<Integer>>ans = new ArrayList<>();
         find(0 , new ArrayList<>() , ans , nums);
         return ans;
    }
}
