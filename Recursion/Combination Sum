class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> res= new ArrayList<>();
        helper(0,candidates,target,0,res,new ArrayList<>());
        return res;
    }
    void helper(int ind,int[]arr , int target,int sum ,List<List<Integer>> res , ArrayList<Integer>ds)
    {

            if(sum==target)//thissssssssss
            {
            res.add(new ArrayList<>(ds));
            return;
        }
        if(ind == arr.length || sum>target) //thisssss
        return;

        ds.add(arr[ind]);
        helper(ind,arr,target,sum+arr[ind],res,ds);//no ind+1 as in
        //subsequence sum = k ,so we need to check sum>target 
        ds.remove(ds.size()-1);
        helper(ind+1,arr,target,sum,res,ds);
    }
}
