class Solution {
    public List<List<String>> solveNQueens(int n) {
    char board[][] = new char [n][n];
   List<List<String>> res = new ArrayList<>();
   for(int i = 0 ; i< n ; i++)
   {
    for(int j = 0 ; j<n;j++)
    {
board[i][j] ='.';
    }
   }
   solve(board , 0 , n , res);
   return res;
    }
    void solve(char board[][] , int row , int n , List<List<String>> res)
    {
        if (row == n) {
    res.add(construct(board));
    return;
}
//column pr loop till n
        for(int i = 0; i< n; i++)
        {
                if(isSafe(board , row, i  ,n))
                {
                board[row][i] = 'Q';
                solve(board , row+1, n , res);
            board[row][i] = '.';
        }
    }
    }
    boolean isSafe(char board[][] , int row , int col , int n )
    {
        for(int i = 0 ; i<n;i++)
        {
            if(board[i][col] == 'Q') 
            return false;
        }

        for(int i = 0 ; i<n;i++)
        {
            if(board[row][i] == 'Q') 
            return false;
        }
//left diagonalll
        for(int k = row , j = col ; k>=0 && j>=0; k--,j--)
        {
            if(board[k][j] == 'Q')
            return false;
        }
//right diagonall
        for(int k = row , j = col ; k>=0 && j<n; k--,j++)
        {
            if(board[k][j] == 'Q')
            return false;
        }
        return true;
    }
//thisssssssssssssssssss
      List<String> construct(char[][] board) {
        List<String> path = new ArrayList<>();
        for (int i = 0; i < board.length; i++) {
            path.add(new String(board[i]));
        }
        return path;
    }
}
